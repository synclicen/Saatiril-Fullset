<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- UVC Video Class devices (HDMI capture cards, webcams, etc.) -->
    <!-- USB Video Class: Class 239, Subclass 2 (Modern UVC spec) -->
    <usb-device class="239" subclass="2" protocol="1" />
    <!-- Legacy video class -->
    <usb-device class="14" subclass="1" protocol="0" />
    <usb-device class="14" subclass="2" protocol="0" />
    <!-- Common capture card vendor IDs (DECIMAL values, not hex!) -->
    <usb-device vendor-id="1161" />   <!-- Fushicai (0x0489) -->
    <usb-device vendor-id="13407" />  <!-- MacroSilicon (0x345F) — JASOZ capture card -->
    <usb-device vendor-id="1046" />   <!-- Magewell (0x0416) -->
    <usb-device vendor-id="5961" />   <!-- Elgato/Corsair (0x1749) -->
    <usb-device vendor-id="4544" />   <!-- AverMedia (0x11C0) -->
    <usb-device vendor-id="1060" />   <!-- Genki (0x0424) -->
    <!-- Broad UVC catch-all: Video class 14 (0x0E) -->
    <usb-device class="14" subclass="1" />
</resources>
